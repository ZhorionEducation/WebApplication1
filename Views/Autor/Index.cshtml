@model IEnumerable<WebApplication1.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="container py-5">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-people-fill text-primary"></i>
                Autores
            </h1>

            <p class="text-muted mb-0">
                Lista de autores registrados
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-person-plus-fill"></i>
            Nuevo Autor
        </a>

    </div>

    <!-- Tarjeta -->
    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-primary text-white py-3 rounded-top-4">

            <div class="d-flex justify-content-between align-items-center">

                <span class="fw-semibold">
                    <i class="bi bi-list-ul"></i>
                    Lista de autores
                </span>

                <span class="badge bg-light text-primary">
                    @Model.Count() autores
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th class="ps-4">
                                    <i class="bi bi-person-fill"></i>
                                    Nombre
                                </th>

                                <th class="text-center" style="width: 280px;">
                                    Acciones
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10 rounded-circle
                                                d-flex align-items-center justify-content-center me-3"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi bi-person text-primary"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @Html.DisplayFor(modelItem => item.Nombre)
                                            </span>

                                        </div>
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-info btn-sm"
                                               title="Ver detalles">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary btn-sm"
                                               title="Editar">

                                                <i class="bi bi-pencil-fill"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger btn-sm"
                                               title="Eliminar">

                                                <i class="bi bi-trash3-fill"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Sin autores -->
                <div class="text-center py-5">

                    <i class="bi bi-people text-secondary"
                       style="font-size: 4rem;"></i>

                    <h4 class="mt-3">
                        No hay autores registrados
                    </h4>

                    <p class="text-muted">
                        Comienza registrando tu primer autor.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-person-plus-fill"></i>
                        Crear primer autor

                    </a>

                </div>
            }

        </div>

    </div>

</div>
