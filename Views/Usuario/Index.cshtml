@model IEnumerable<WebApplication1.Models.Usuario>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <!-- Encabezado -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-people me-2"></i>
                    Usuarios
                </h3>
                <small>Listado de usuarios registrados</small>
            </div>

            <a asp-action="Create" class="btn btn-light">
                <i class="bi bi-person-plus me-1"></i>
                Nuevo usuario
            </a>
        </div>

        <div class="card-body">
            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>@TempData["Mensaje"]</strong>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Cerrar">
                    </button>
                </div>
            }

            @if (Model.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">
                        <i class="bi bi-people me-1"></i>
                        Total de usuarios:
                        <strong>@Model.Count()</strong>
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>
                                    <i class="bi bi-person me-1"></i>
                                    Nombre
                                </th>

                                <th>
                                    <i class="bi bi-card-text me-1"></i>
                                    Documento
                                </th>

                                <th>
                                    <i class="bi bi-envelope me-1"></i>
                                    Correo
                                </th>

                                <th class="text-center">
                                    <i class="bi bi-credit-card me-1"></i>
                                    Tarjeta
                                </th>

                                <th class="text-center">
                                    Acciones
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Nombre -->
                                    <td>
                                        <strong>@item.Nombre</strong>
                                    </td>

                                    <!-- Documento -->
                                    <td>
                                        @item.Documento
                                    </td>

                                    <!-- Correo -->
                                    <td>
                                        <i class="bi bi-envelope me-1 text-muted"></i>
                                        @item.Correo
                                    </td>

                                    <!-- Tarjeta -->
                                    <td class="text-center">
                                        @if (item.TarjetaPrestamo)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Habilitada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-x-circle me-1"></i>
                                                No habilitada
                                            </span>
                                        }
                                    </td>

                                    <!-- Acciones -->
                                    <td>
                                        <div class="d-flex flex-wrap justify-content-center gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-xl-inline">
                                                    Detalles
                                                </span>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i>
                                                <span class="d-none d-xl-inline">
                                                    Editar
                                                </span>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-xl-inline">
                                                    Eliminar
                                                </span>
                                            </a>

                                            <!-- Prestar -->
                                            <a asp-action="Prestar"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                                <span class="d-none d-xl-inline">
                                                    Prestar
                                                </span>
                                            </a>

                                            <!-- Devolver -->
                                            <form asp-action="Devolver"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-arrow-return-left"></i>
                                                    <span class="d-none d-xl-inline">
                                                        Devolver
                                                    </span>
                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <!-- Estado vacío -->
                <div class="text-center py-5">

                    <i class="bi bi-people display-1 text-muted"></i>

                    <h4 class="mt-3">
                        No hay usuarios registrados
                    </h4>

                    <p class="text-muted">
                        Todavía no se ha registrado ningún usuario.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-person-plus me-1"></i>
                        Registrar primer usuario
                    </a>

                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <script>
        setTimeout(function() {
            const alert = document.querySelector('.alert');

            if (alert) {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
                bsAlert.close();
            }
        }, 4000);
    </script>
}