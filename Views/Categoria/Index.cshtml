@model IEnumerable<WebApplication1.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
}

<div class="container py-5">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                <i class="bi bi-tags-fill text-primary me-2"></i>
                Categorías
            </h1>

            <p class="text-muted mb-0">
                <i class="bi bi-list-ul me-1"></i>
                Lista de categorías registradas
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva Categoría
        </a>

    </div>

    <!-- Tarjeta -->
    <div class="card shadow border-0 rounded-4">

        <div class="card-header bg-primary text-white py-3 rounded-top-4">

            <div class="d-flex justify-content-between align-items-center">

                <span class="fw-semibold">
                    <i class="bi bi-tags me-2"></i>
                    Lista de categorías
                </span>

                <span class="badge bg-light text-primary">
                    <i class="bi bi-collection me-1"></i>
                    @Model.Count() categorías
                </span>

            </div>

        </div>

        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    <i class="bi bi-tag me-1"></i>
                                    Nombre
                                </th>

                                <th class="text-center" style="width: 280px;">
                                    <i class="bi bi-gear me-1"></i>
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="d-flex align-items-center">

                                            <div class="bg-primary bg-opacity-10 rounded-circle
                                                d-flex align-items-center justify-content-center me-3"
                                                 style="width: 40px; height: 40px;">

                                                <i class="bi bi-tag text-primary"></i>

                                            </div>

                                            <span class="fw-semibold">
                                                @Html.DisplayFor(modelItem => item.Nombre)
                                            </span>

                                        </div>

                                    </td>

                                    <td class="text-center">

                                        <!-- Detalles -->
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm text-white"
                                           title="Ver detalles">

                                            <i class="bi bi-eye me-1"></i>
                                            Detalles

                                        </a>

                                        <!-- Editar -->
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-primary btn-sm"
                                           title="Editar">

                                            <i class="bi bi-pencil me-1"></i>
                                            Editar

                                        </a>

                                        <!-- Eliminar -->
                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm"
                                           title="Eliminar">

                                            <i class="bi bi-trash me-1"></i>
                                            Eliminar

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Sin categorías -->
                <div class="text-center py-5">

                    <i class="bi bi-tags display-1 text-muted"></i>

                    <h4 class="mt-3">
                        <i class="bi bi-info-circle me-1"></i>
                        No hay categorías registradas
                    </h4>

                    <p class="text-muted">
                        Comienza registrando tu primera categoría.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Crear primera categoría

                    </a>

                </div>
            }

        </div>

    </div>

</div>

