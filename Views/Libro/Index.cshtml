@model IEnumerable<WebApplication1.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <!-- Encabezado -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-book me-2"></i> Libros
                </h3>
                <small>Listado de libros registrados</small>
            </div>

            <a asp-action="Create" class="btn btn-light">
                <i class="bi bi-plus-circle me-1"></i> Nuevo libro
            </a>
        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted">
                        <i class="bi bi-collection me-1"></i>
                        Total de libros: <strong>@Model.Count()</strong>
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>
                                    <i class="bi bi-book me-1"></i>
                                    Título
                                </th>
                                <th>
                                    <i class="bi bi-tags me-1"></i>
                                    Categoría
                                </th>
                                <th>
                                    <i class="bi bi-person me-1"></i>
                                    Autor
                                </th>
                                <th class="text-center">
                                    <i class="bi bi-bookmark-check me-1"></i>
                                    Estado
                                </th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Titulo</strong>
                                    </td>

                                    <td>
                                        @if (item.Categoria != null)
                                        {
                                            <span class="badge bg-info text-dark">
                                                @item.Categoria.Nombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin categoría</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Autor != null)
                                        {
                                            <span>
                                                <i class="bi bi-person-circle me-1"></i>
                                                @item.Autor.Nombre
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sin autor</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (item.Prestado)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-arrow-up-right-circle me-1"></i>
                                                Prestado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Disponible
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                                <span class="d-none d-lg-inline"> Detalles</span>
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Editar libro">
                                                <i class="bi bi-pencil"></i>
                                                <span class="d-none d-lg-inline"> Editar</span>
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Eliminar libro">
                                                <i class="bi bi-trash"></i>
                                                <span class="d-none d-lg-inline"> Eliminar</span>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-book display-1 text-muted"></i>

                    <h4 class="mt-3">
                        No hay libros registrados
                    </h4>

                    <p class="text-muted">
                        Todavía no se ha registrado ningún libro.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Registrar primer libro
                    </a>

                </div>
            }

        </div>
    </div>

</div>

