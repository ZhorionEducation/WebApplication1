@model WebApplication1.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">

            <div class="card shadow border-0 rounded-4">

                <!-- Encabezado -->
                <div class="card-header bg-danger text-white text-center py-4 rounded-top-4">

                    <div class="mb-2">
                        <i class="bi bi-exclamation-triangle-fill"
                           style="font-size: 3.5rem;"></i>
                    </div>

                    <h2 class="mb-1">
                        Eliminar Libro
                    </h2>

                    <p class="mb-0 opacity-75">
                        Esta acción no se puede deshacer
                    </p>

                </div>

                <!-- Información -->
                <div class="card-body p-4">

                    <div class="alert alert-warning d-flex align-items-center"
                         role="alert">

                        <i class="bi bi-exclamation-circle-fill me-2"></i>

                        <div>
                            ¿Está seguro de que desea eliminar este libro?
                        </div>

                    </div>

                    <!-- Libro -->
                    <div class="text-center py-3">

                        <div class="mb-3">
                            <i class="bi bi-book-fill text-secondary"
                               style="font-size: 4rem;"></i>
                        </div>

                        <h3 class="fw-bold mb-4">
                            @Html.DisplayFor(model => model.Titulo)
                        </h3>

                    </div>

                    <!-- Información del libro -->
                    <div class="border rounded-3 p-3 bg-light">

                        <div class="row g-3">

                            <!-- Título -->
                            <div class="col-12">

                                <div class="d-flex align-items-center">

                                    <i class="bi bi-book text-primary me-3"
                                       style="font-size: 1.5rem;"></i>

                                    <div>
                                        <small class="text-muted d-block">
                                            Título
                                        </small>

                                        <span class="fw-semibold">
                                            @Html.DisplayFor(model => model.Titulo)
                                        </span>
                                    </div>

                                </div>

                            </div>

                            <!-- Autor -->
                            <div class="col-12">

                                <div class="d-flex align-items-center">

                                    <i class="bi bi-person-fill text-primary me-3"
                                       style="font-size: 1.5rem;"></i>

                                    <div>
                                        <small class="text-muted d-block">
                                            Autor
                                        </small>

                                        <span class="fw-semibold">
                                            @if (Model.Autor != null)
                                            {
                                                @Model.Autor.Nombre
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    Sin autor
                                                </span>
                                            }
                                        </span>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Botones -->
                    <form asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-left"></i>
                                Cancelar

                            </a>

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-trash3-fill"></i>
                                Eliminar Libro

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>
